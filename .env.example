# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Channel that receives the daily report at 12:00 AM America/New_York
STATS_CHANNEL_ID=1548706786893238322

# Optional: register /stats only in this guild (instant) instead of globally (can take up to an hour)
GUILD_ID=

# Optional: path to the SQLite database file
DATABASE_PATH=./data/stats.db

# Optional: IANA timezone used for day boundaries and the midnight report
TIMEZONE=America/New_York

# Member milestones: when the member count reaches one of these, the bot posts
# a snapshot image and pings MILESTONE_USER_ID (default: the server owner) in
# MILESTONE_CHANNEL_ID (default: STATS_CHANNEL_ID). Comma separated.
MILESTONES=100
MILESTONE_CHANNEL_ID=
MILESTONE_USER_ID=

# Link gate: members need this many messages before they can post links
# (GIFs are always allowed). 0 turns it off. Mods with Manage Messages and the
# comma separated LINK_EXEMPT_ROLE_IDS are exempt.
LINK_MIN_MESSAGES=50
LINK_EXEMPT_ROLE_IDS=

# Dungeon Delve: the room server is polled for characters setting out, and
# each one is announced in this channel. DUNGEON_SECRET must match the
# ANNOUNCE_SECRET on the room server if one is set there.
DUNGEON_API=https://ssorw.com
DUNGEON_SECRET=
DUNGEON_CHANNEL_ID=1555979173917499432
DUNGEON_POLL_MS=15000
